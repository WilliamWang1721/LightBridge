replace_exact(
    "backend/internal/service/backup_service.go",
    """func (s *BackupService) StartBackup(ctx context.Context, triggeredBy string, expireDays int) (*BackupRecord, error) {
\tif s.shuttingDown.Load() {
\t\treturn nil, infraerrors.ServiceUnavailable("SERVER_SHUTTING_DOWN", "server is shutting down")
\t}

\ts.opMu.Lock()
\tif s.backingUp {
\t\ts.opMu.Unlock()
\t\treturn nil, ErrBackupInProgress
\t}
\ts.backingUp = true
\ts.opMu.Unlock()

""",
    """func (s *BackupService) StartBackup(ctx context.Context, triggeredBy string, expireDays int) (*BackupRecord, error) {
\ts.opMu.Lock()
\tif s.backingUp {
\t\ts.opMu.Unlock()
\t\treturn nil, ErrBackupInProgress
\t}
\ts.backingUp = true
\ts.opMu.Unlock()

\tfinish, err := s.beginTrackedOperation()
\tif err != nil {
\t\ts.opMu.Lock()
\t\ts.backingUp = false
\t\ts.opMu.Unlock()
\t\treturn nil, err
\t}

""",
)

