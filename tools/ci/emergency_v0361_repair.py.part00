#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def path_for(relative: str) -> Path:
    return ROOT / relative


def replace_exact(relative: str, old: str, new: str, expected: int = 1) -> None:
    path = path_for(relative)
    text = path.read_text(encoding="utf-8")
    count = text.count(old)
    if count != expected:
        raise RuntimeError(
            f"{relative}: expected {expected} occurrence(s), found {count}: {old[:120]!r}"
        )
    path.write_text(text.replace(old, new), encoding="utf-8")


def write(relative: str, content: str) -> None:
    path = path_for(relative)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


# Serialize operation admission with shutdown. sync.WaitGroup requires positive
# Add calls that may start from zero to happen before a concurrent Wait.
replace_exact(
    "backend/internal/service/backup_service.go",
    "\twg           sync.WaitGroup     // 追踪活跃的备份/恢复 goroutine\n\tshuttingDown atomic.Bool        // 阻止新备份启动\n",
    "\tlifecycleMu  sync.Mutex         // 串行化活跃操作准入与关机等待\n\twg           sync.WaitGroup     // 追踪活跃的备份/恢复 goroutine\n\tshuttingDown atomic.Bool        // 阻止新备份启动\n",
)

replace_exact(
    "backend/internal/service/backup_service.go",
    "\n// Start 启动定时备份调度器并清理孤立记录\n",
    """
// beginTrackedOperation atomically admits an operation before shutdown starts.
// The lifecycle mutex prevents a positive WaitGroup.Add from racing with Stop's
// Wait when the counter is zero.
func (s *BackupService) beginTrackedOperation() (func(), error) {
\ts.lifecycleMu.Lock()
\tdefer s.lifecycleMu.Unlock()
\tif s.shuttingDown.Load() {
\t\treturn nil, infraerrors.ServiceUnavailable("SERVER_SHUTTING_DOWN", "server is shutting down")
\t}
\ts.wg.Add(1)
\tvar once sync.Once
\treturn func() {
\t\tonce.Do(s.wg.Done)
\t}, nil
}

// Start 启动定时备份调度器并清理孤立记录
""",
)

replace_exact(
